[["Бромная вода — качественная реакция", "HC≡CH + Br₂ ⟶ BrCH=CHBr", "бромная вода, обычные условия", "При взаимодействии с алкинами бромная вода обесцвечивается."], ["Избыток бромной воды", "HC≡CH + 2Br₂ ⟶ CHBr₂–CHBr₂", "избыток бромной воды", "Полное присоединение двух молекул Br₂."], ["Гидрирование: одна молекула H₂", "HC≡CH + H₂ ⟶ CH₂=CH₂", "Ni или Pt, нагревание", "Первая стадия: алкин превращается в алкен; процесс может продолжаться."], ["Гидрирование: две молекулы H₂", "HC≡CH + 2H₂ ⟶ CH₃–CH₃", "Ni или Pt, нагревание", "Полное гидрирование с образованием алкана."], ["Присоединение HCl", "HC≡CH + HCl ⟶ CH₂=CHCl", "присоединение HCl", "Получается хлорэтен (винилхлорид)."], ["Полимеризация винилхлорида", "nCH₂=CHCl ⟶ (–CH₂–CHCl–)ₙ", "полимеризация", "Образуется поливинилхлорид (ПВХ)."], ["Гидратация ацетилена: реакция Кучерова", "HC≡CH + H₂O ⟶ CH₃CHO", "HgSO₄, H₂SO₄, нагревание", "Образуется этаналь (уксусный альдегид)."], ["Циклотримеризация ацетилена", "3HC≡CH ⟶ C₆H₆", "активированный уголь, 450 °C", "Из трёх молекул ацетилена образуется бензол."], ["Горение ацетилена", "2C₂H₂ + 5O₂ ⟶ 4CO₂ + 2H₂O", "поджигание, избыток кислорода", "Полное окисление алкина."], ["Раствор KMnO₄ — качественная реакция", "Алкин + KMnO₄ (водный раствор) ⟶ продукты окисления", "водный раствор KMnO₄", "Фиолетовый раствор обесцвечивается. В базовом тренажёре не требуется записывать уравнение окисления алкина."], ["Карбидный способ", "CaC₂ + 2H₂O ⟶ HC≡CH + Ca(OH)₂", "вода", "Получение ацетилена."], ["Пиролиз метана", "2CH₄ ⟶ HC≡CH + 3H₂", "≈1500 °C, быстрое охлаждение", "Получение ацетилена из метана."], ["Дегидрогалогенирование", "BrCH₂–CH₂Br + 2KOH ⟶ HC≡CH + 2KBr + 2H₂O", "спиртовой раствор KOH, нагревание", "Получение ацетилена из 1,2-дибромэтана."]]