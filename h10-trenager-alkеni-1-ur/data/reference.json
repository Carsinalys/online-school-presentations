[["Бромная вода — качественная реакция", "CH₂=CH₂ + Br₂ ⟶ BrCH₂–CH₂Br", "бромная вода, обычные условия", "Оранжевая окраска бромной воды исчезает при взаимодействии с алкеном."], ["Присоединение хлора", "CH₂=CH₂ + Cl₂ ⟶ ClCH₂–CH₂Cl", "обычные условия", "Алкены присоединяют хлор по двойной связи."], ["Гидрирование", "CH₂=CH₂ + H₂ ⟶ CH₃–CH₃", "Ni или Pt, нагревание", "Алкен присоединяет H₂ и превращается в алкан."], ["Гидрогалогенирование", "CH₂=CH₂ + HBr ⟶ CH₃–CH₂Br", "обычные условия", "Галогеноводород присоединяется по двойной связи этена."], ["Гидратация", "CH₂=CH₂ + H₂O ⟶ CH₃–CH₂OH", "H₂SO₄, нагревание", "Вода присоединяется к этену, образуется этанол."], ["Полимеризация этена", "nCH₂=CH₂ ⟶ (–CH₂–CH₂–)ₙ", "полимеризация", "Этен образует полиэтилен."], ["Полимеризация пропена", "nCH₂=CH–CH₃ ⟶ (–CH₂–CH(CH₃)–)ₙ", "полимеризация", "Пропен образует полипропилен."], ["Горение (полное окисление)", "CH₂=CH₂ + 3O₂ ⟶ 2CO₂ + 2H₂O", "поджигание, кислород", "При полном сгорании образуются CO₂ и H₂O."], ["Неполное окисление раствором KMnO₄", "3CH₂=CH₂ + 2KMnO₄ + 4H₂O ⟶ 3HOCH₂CH₂OH + 2MnO₂ + 2KOH", "разбавленный водный KMnO₄, около 5 °C", "Раствор обесцвечивается, появляется бурый осадок MnO₂; образуется этиленгликоль."], ["Получение алкенов: дегидратация спирта", "CH₃CH₂OH ⟶ CH₂=CH₂ + H₂O", "конц. H₂SO₄, t > 140 °C", "Отщепление воды от этанола."], ["Получение алкенов: дегидрирование алкана", "CH₃–CH₃ ⟶ CH₂=CH₂ + H₂", "Cr₂O₃, ≈500 °C", "Отщепление водорода от этана."], ["Получение алкенов: дегидрогалогенирование", "CH₃CH₂CH₂Cl + KOH ⟶ CH₃CH=CH₂ + KCl + H₂O", "спиртовой раствор KOH, нагревание", "Отщепление HCl от хлорпропана."]]