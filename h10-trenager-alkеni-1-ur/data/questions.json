ен → Углекислый газ", "left": "CH₂=CH₂ + 3O₂", "right": "2CO₂ + 2H₂O", "cond": "избыток O₂, поджигание", "typ": "Горение (полное окисление)", "hint": "При полном горении образуются CO₂ и H₂O. Расставь коэффициенты.", "note": "", "prefix": ""}, {"id": 9, "g": "ethene", "goal": "Этен → Этиленгликоль", "left": "3CH₂=CH₂ + 2KMnO₄ + 4H₂O", "right": "3HO–CH₂–CH₂–OH + 2MnO₂ + 2KOH", "cond": "разбавленный водный KMnO₄, около 5 °C", "typ": "Неполное окисление (KMnO₄)", "hint": "Два атома OH присоединяются к соседним атомам углерода. Появляется бурый MnO₂.", "note": "Фиолетовый раствор KMnO₄ обесцвечивается; образуется бурый осадок MnO₂. Это качественная реакция на двойную связь.", "prefix": ""}, {"id": 10, "g": "propene", "goal": "Пропен → Пропан", "left": "CH₃–CH=CH₂ + H₂", "right": "CH₃–CH₂–CH₃", "cond": "Ni, t°", "typ": "Гидрирование", "hint": "Добавь H₂ к двойной связи.", "note": "", "prefix": ""}, {"id": 11, "g": "propene", "goal": "Пропен → 1,2-дибромпропан", "left": "CH₃–CH=CH₂ + Br₂", "right": "CH₃–CHBr–CH₂Br", "cond": "бромная вода, обычные условия", "typ": "Присоединение брома", "hint": "Два Br присоединяются по разным атомам углерода бывшей двойной связи. Бромная вода обесцвечивается.", "note": "Признак качественной реакции на двойную связь — обесцвечивание бромной воды.", "prefix": ""}, {"id": 12, "g": "propene", "goal": "Пропен → 1,2-дихлорпропан", "left": "CH₃–CH=CH₂ + Cl₂", "right": "CH₃–CHCl–CH₂Cl", "cond": "обычные условия", "typ": "Присоединение хлора", "hint": "Раскрой двойную связь и присоедини два Cl.", "note": "", "prefix": ""}, {"id": 13, "g": "propene", "goal": "Пропен → Полипропилен", "left": "nCH₂=CH–CH₃", "right": "(–CH₂–CH(CH₃)–)ₙ", "cond": "катализатор, t°, p", "typ": "Полимеризация", "hint": "В полимерной цепи сохраняются боковые группы CH₃. Не забудь n.", "note": "", "prefix": ""}, {"id": 14, "g": "propene", "goal": "Пропен → Углекислый газ", "left": "2C₃H₆ + 9O₂", "right": "6CO₂ + 6H₂O", "cond": "избыток O₂, поджигание", "typ": "Горение (полное окисление)", "hint": "При полном горении образуются CO₂ и H₂O; расставь целые коэффициенты.", "note": "", "prefix": ""}, {"id": 15, "g": "propene", "goal": "Пропен → Пропандиол-1,2", "left": "3CH₃–CH=CH₂ + 2KMnO₄ + 4H₂O", "right": "3CH₃–CH(OH)–CH₂OH + 2MnO₂ + 2KOH", "cond": "разбавленный водный KMnO₄, около 5 °C", "typ": "Неполное окисление (KMnO₄)", "hint": "Две группы OH образуются на соседних атомах углерода бывшей двойной связи.", "note": "Фиолетовый раствор KMnO₄ обесцвечивается; образуется бурый осадок MnO₂. Это качественная реакция на двойную связь.", "prefix": ""}, {"id": 16, "g": "butene1", "goal": "Бутен-1 → Бутан", "left": "CH₂=CH–CH₂–CH₃ + H₂", "right": "CH₃–CH₂–CH₂–CH₃", "cond": "Ni, t°", "typ": "Гидрирование", "hint": "Добавление H₂ превращает двойную связь в одинарную.", "note": "", "prefix": ""}, {"id": 17, "g": "butene1", "goal": "Бутен-1 → 1,2-дибромбутан", "left": "CH₂=CH–CH₂–CH₃ + Br₂", "right": "BrCH₂–CHBr–CH₂–CH₃", "cond": "бромная вода, обычные условия", "typ": "Бромирование (присоединение)", "hint": "Br₂ присоединяется по двойной связи. Бромная вода обесцвечивается.", "note": "Признак качественной реакции на двойную связь — обесцвечивание бромной воды.", "prefix": ""}, {"id": 18, "g": "butene1", "goal": "Бутен-1 → 1,2-дихлорбутан", "left": "CH₂=CH–CH₂–CH₃ + Cl₂", "right": "ClCH₂–CHCl–CH₂–CH₃", "cond": "обычные условия", "typ": "Хлорирование (присоединение)", "hint": "Каждый атом углерода бывшей двойной связи получает один Cl.", "note": "", "prefix": ""}, {"id": 19, "g": "butene1", "goal": "Бутен-1 → Углекислый газ", "left": "C₄H₈ + 6O₂", "right": "4CO₂ + 4H₂O", "cond": "избыток O₂, поджигание", "typ": "Горение (полное окисление)", "hint": "Используй общую формулу алкенов CₙH₂ₙ.", "note": "", "prefix": ""}, {"id": 20, "g": "butene1", "goal": "Бутен-1 → Бутандиол-1,2", "left": "3CH₂=CH–CH₂–CH₃ + 2KMnO₄ + 4H₂O", "right": "3HOCH₂–CH(OH)–CH₂–CH₃ + 2MnO₂ + 2KOH", "cond": "разбавленный водный KMnO₄, около 5 °C", "typ": "Неполное окисление (KMnO₄)", "hint": "Две группы OH оказываются у соседних углеродов 1 и 2.", "note": "Фиолетовый раствор KMnO₄ обесцвечивается; образуется бурый осадок MnO₂. Это качественная реакция на двойную связь.", "prefix": ""}, {"id": 21, "g": "butene2", "goal": "Бутен-2 → Бутан", "left": "CH₃–CH=CH–CH₃ + H₂", "right": "CH₃–CH₂–CH₂–CH₃", "cond": "Ni, t°", "typ": "Гидрирование", "hint": "Присоедини водород к двум атомам углерода двойной связи.", "note": "", "prefix": ""}, {"id": 22, "g": "butene2", "goal": "Бутен-2 → 2-бромбутан", "left": "CH₃–CH=CH–CH₃ + HBr", "right": "CH₃–CHBr–CH₂–CH₃", "cond": "обычные условия", "typ": "Гидробромирование", "hint": "Молекула симметрична, поэтому присоединение HBr даёт один структурный продукт (в виде смеси энантиомеров).", "note": "", "prefix": ""}, {"id": 23, "g": "butene2", "goal": "Бутен-2 → Бутан-2-ол", "left": "CH₃–CH=CH–CH₃ + H₂O", "right": "CH₃–CH(OH)–CH₂–CH₃", "cond": "H⁺, t°", "typ": "Гидратация", "hint": "Вода присоединяется по двойной связи; образуется вторичный спирт.", "note": "", "prefix": ""}, {"id": 24, "g": "butene2", "goal": "Бутен-2 → 2,3-дибромбутан", "left": "CH₃–CH=CH–CH₃ + Br₂", "right": "CH₃–CHBr–CHBr–CH₃", "cond": "бромная вода, обычные условия", "typ": "Присоединение брома", "hint": "Оба атома брома присоединяются к соседним углеродам. Бромная вода обесцвечивается.", "note": "Признак качественной реакции на двойную связь — обесцвечивание бромной воды.", "prefix": ""}, {"id": 25, "g": "butene2", "goal": "Бутен-2 → 2,3-дихлорбутан", "left": "CH₃–CH=CH–CH₃ + Cl₂", "right": "CH₃–CHCl–CHCl–CH₃", "cond": "обычные условия", "typ": "Присоединение хлора", "hint": "Присоедини Cl₂ по двойной связи.", "note": "", "prefix": ""}, {"id": 26, "g": "butene2", "goal": "Бутен-2 → Бутандиол-2,3", "left": "3CH₃–CH=CH–CH₃ + 2KMnO₄ + 4H₂O", "right": "3CH₃–CH(OH)–CH(OH)–CH₃ + 2MnO₂ + 2KOH", "cond": "разбавленный водный KMnO₄, около 5 °C", "typ": "Неполное окисление (KMnO₄)", "hint": "Гидроксильные группы появляются у C-2 и C-3.", "note": "Фиолетовы